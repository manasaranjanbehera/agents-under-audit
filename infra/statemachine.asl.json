{
  "Comment": "Corvane comms triage: dedupe -> quarantined reader -> policy decider -> case record -> analyst notification",
  "StartAt": "NormaliseEvent",
  "States": {
    "NormaliseEvent": {
      "Type": "Pass",
      "Parameters": {
        "event_id.$": "$.id",
        "bucket.$": "$.detail.bucket.name",
        "key.$": "$.detail.object.key"
      },
      "Next": "ClaimEvent"
    },
    "ClaimEvent": {
      "Type": "Task",
      "Comment": "EventBridge delivers at least once; a repeat event id stops here instead of paying for a second model call. If the claim itself fails, triage continues: a possible duplicate is cheaper than a dropped conversation.",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${CasesTableName}",
        "Item": {
          "conversation_id": {"S.$": "States.Format('event#{}', $.event_id)"},
          "decided_at": {"S": "claim"},
          "claimed_at": {"S.$": "$$.State.EnteredTime"},
          "record_type": {"S": "event_claim"},
          "source_key": {"S.$": "$.key"},
          "execution_arn": {"S.$": "$$.Execution.Id"}
        },
        "ConditionExpression": "attribute_not_exists(conversation_id)"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.InternalServerErrorException",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDB.ThrottlingException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": null,
          "Next": "DuplicateEvent"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.claim_error",
          "Next": "ReadConversation"
        }
      ],
      "Next": "ReadConversation"
    },
    "DuplicateEvent": {
      "Type": "Succeed"
    },
    "ReadConversation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ReaderFunctionArn}",
        "Payload": {
          "bucket.$": "$.bucket",
          "key.$": "$.key"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 3,
          "MaxAttempts": 8,
          "BackoffRate": 2,
          "MaxDelaySeconds": 30,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Decide"
    },
    "Decide": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DeciderFunctionArn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "DecideFailed"
        }
      ],
      "Next": "RecordCase"
    },
    "RecordCase": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${CasesTableName}",
        "Item": {
          "conversation_id": {"S.$": "$.conversation_id"},
          "decided_at": {"S.$": "$.decision.decided_at"},
          "record_type": {"S": "case"},
          "disposition": {"S.$": "$.decision.disposition"},
          "reasons": {"S.$": "States.JsonToString($.decision.reasons)"},
          "policy_version": {"S.$": "$.decision.policy_version"},
          "prompt_version": {"S.$": "$.audit.prompt_version"},
          "model_id": {"S.$": "$.audit.model_id"},
          "source_key": {"S.$": "$.audit.source_key"},
          "input_tokens": {"N.$": "States.Format('{}', $.audit.input_tokens)"},
          "output_tokens": {"N.$": "States.Format('{}', $.audit.output_tokens)"},
          "cost_usd": {"N.$": "$.audit.cost_usd"},
          "execution_arn": {"S.$": "$$.Execution.Id"},
          "record": {"S.$": "States.JsonToString($)"}
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "RecordCaseFailed"
        }
      ],
      "Next": "NeedsAnalyst"
    },
    "NeedsAnalyst": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.decision.disposition",
          "StringEquals": "close",
          "Next": "Closed"
        }
      ],
      "Default": "NotifyAnalyst"
    },
    "NotifyAnalyst": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AnalystTopicArn}",
        "Subject.$": "States.Format('Comms triage: {} {}', $.decision.disposition, $.conversation_id)",
        "Message.$": "States.Format('Conversation {} routed to {}. Reasons: {}. Execution: {}', $.conversation_id, $.decision.disposition, States.JsonToString($.decision.reasons), $$.Execution.Id)"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "Closed": {
      "Type": "Succeed"
    },
    "DecideFailed": {
      "Type": "Pass",
      "Parameters": {
        "key.$": "$.source.key",
        "error.$": "$.error"
      },
      "Next": "RecordFailure"
    },
    "RecordCaseFailed": {
      "Type": "Pass",
      "Parameters": {
        "key.$": "$.audit.source_key",
        "error.$": "$.error"
      },
      "Next": "NotifyFailure"
    },
    "RecordFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${CasesTableName}",
        "Item": {
          "conversation_id": {"S.$": "States.Format('failed#{}', $.key)"},
          "decided_at": {"S.$": "$$.State.EnteredTime"},
          "record_type": {"S": "failure"},
          "disposition": {"S": "human_review"},
          "source_key": {"S.$": "$.key"},
          "reasons": {"S.$": "States.JsonToString($.error)"},
          "execution_arn": {"S.$": "$$.Execution.Id"}
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.record_error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "NotifyFailure"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AnalystTopicArn}",
        "Subject": "Comms triage: pipeline failure, human review required",
        "Message.$": "States.Format('Object {} could not be triaged automatically. Error: {}. Execution: {}', $.key, States.JsonToString($.error), $$.Execution.Id)"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    }
  }
}
