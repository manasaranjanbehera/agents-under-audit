{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeTriageFunctions",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:${Region}:${AccountId}:function:comms-triage-reader",
        "arn:aws:lambda:${Region}:${AccountId}:function:comms-triage-reader:*",
        "arn:aws:lambda:${Region}:${AccountId}:function:comms-triage-decider",
        "arn:aws:lambda:${Region}:${AccountId}:function:comms-triage-decider:*"
      ]
    },
    {
      "Sid": "WriteCaseRecords",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:${Region}:${AccountId}:table/comms-triage-cases"
    },
    {
      "Sid": "NotifyAnalysts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:${Region}:${AccountId}:comms-triage-analyst-alerts"
    }
  ]
}
