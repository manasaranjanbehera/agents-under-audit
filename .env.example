# Copy to .env and fill in. Never commit .env.
# Load with: uv run --env-file .env triage <command>

# AWS credentials come from a named profile, never from long-lived keys in this file.
AWS_PROFILE=comms-triage
AWS_REGION=us-east-1

# Bedrock model. Use the "us." inference profile ID if on-demand access is not offered in your region.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Optional Bedrock Guardrail (prompt-attack filter) applied to the transcript only.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Output cap per model call. Findings are typically ~150 tokens.
MAX_OUTPUT_TOKENS=600

# USD per 1K tokens, used for cost reporting. Verify against current Bedrock pricing.
PRICE_INPUT_PER_1K=0.00006
PRICE_OUTPUT_PER_1K=0.00024
