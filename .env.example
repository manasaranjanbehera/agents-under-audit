# Demo email session
SESSION_SECRET=change-me-in-production

# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# If you do not use OIDC role-based auth from your host, set static credentials:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
MAX_OUTPUT_TOKENS=600
PRICE_INPUT_PER_1K=0.00006
PRICE_OUTPUT_PER_1K=0.00024

# Rate limits
TRIAGE_RATE_LIMIT_PER_HOUR=5

# Alerts (Resend)
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Required in production for persistent OTP/rate limits and case records.
POSTGRES_URL=
